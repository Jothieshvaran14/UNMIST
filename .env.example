# Unmist configuration. Copy to `.env` and fill in real values.
# NEVER commit real secrets to version control.

# --- Runtime ---
ENVIRONMENT=development
# development | test | staging | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
# PostgreSQL in production/staging. SQLite is supported for local dev and tests.
DATABASE_URL=postgresql+psycopg2://unmist:unmist@localhost:5432/unmist
# DATABASE_URL=sqlite:///./data/unmist.db
TEST_DATABASE_URL=sqlite:///./data/unmist_test.db

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
TOKEN_AUDIENCE=unmist-api
# Argon2 work factor (memory KiB). Tune for your hardware.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- Outbound retrieval ---
# Allowlist of permitted outbound hosts for lawful source retrieval.
# Empty = no external retrieval permitted (safe default).
RETRIEVAL_ALLOWED_HOSTS=api.openalex.org,api.semanticscholar.org,raw.githubusercontent.com,en.wikipedia.org
RETRIEVAL_MAX_BYTES=10485760
RETRIEVAL_TIMEOUT_SECONDS=20
RETRIEVAL_MAX_REDIRECTS=3
RETRIEVAL_RESPECT_ROBOTS=true
RETRIEVAL_USER_AGENT=UnmistBot/0.1 (+https://github.com/Jothieshvaran14/Unmist; lawful research use)

# --- LLM / model providers (optional; no live model is called unless configured) ---
# The platform does NOT call any LLM without an explicit provider configuration.
# LLM_PROVIDER=none
# OPENAI_API_KEY=
# LLM_MODEL=

# --- Object storage ---
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=./data/storage
# STORAGE_BUCKET=
# STORAGE_REGION=

# --- Jobs ---
JOB_MAX_ATTEMPTS=3
JOB_POLL_INTERVAL_SECONDS=1.0
