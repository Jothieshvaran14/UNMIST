# Unmist frontend configuration.
# Copy to `.env.local` and adjust. These values are NOT secrets.
# Never place private keys, client secrets, or credentials in Vite env vars —
# anything prefixed VITE_ is baked into the browser bundle and is public.

# Base URL of the Unmist API, up to (but NOT including) `/v1`.
# - Leave unset to use the development proxy (`/api` -> http://localhost:8000),
#   which is the recommended setup and needs no backend CORS configuration.
# - Set an absolute URL to point the built bundle at a deployed API, e.g.
#     VITE_API_BASE_URL=https://api.example.com/api
# The client appends `/v1/...` itself. The backend mounts every router under
# `/api/v1`, so a deployed base must end in `/api` — not `/v1`.
# VITE_API_BASE_URL=

# Target used by the Vite dev/preview proxy when VITE_API_BASE_URL is unset.
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional request timeout in milliseconds (default 20000 when unset).
# VITE_API_TIMEOUT_MS=20000
